// PolyBench/C MEDIUM dataset: N = 400.
fn main() -> int {
    let mut a: [[int; 400]; 400] = [[0; 400]; 400];
    let mut x1: [int; 400] = [0; 400];
    let mut x2: [int; 400] = [0; 400];
    let mut y1: [int; 400] = [0; 400];
    let mut y2: [int; 400] = [0; 400];

    for i in 0..400 {
        x1[i] = i % 7;
        x2[i] = (i + 1) % 11;
        y1[i] = (i + 3) % 13;
        y2[i] = (i + 5) % 17;
        for j in 0..400 {
            a[i][j] = (i * (j + 1) + 1) % 19;
        }
    }

    for i in 0..400 {
        for j in 0..400 {
            x1[i] = x1[i] + a[i][j] * y1[j];
        }
    }
    for i in 0..400 {
        for j in 0..400 {
            x2[i] = x2[i] + a[j][i] * y2[j];
        }
    }

    let mut sum: int = 0;
    for i in 0..400 {
        sum = sum + x1[i] + x2[i];
    }

    print_int(sum);
    print_char(10);
    sum
}
