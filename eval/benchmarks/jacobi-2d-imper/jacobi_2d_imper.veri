fn main() -> int {
    let mut a: [[int; 250]; 250] = [[0; 250]; 250];
    let mut b: [[int; 250]; 250] = [[0; 250]; 250];

    for i in 0..250 {
        for j in 0..250 {
            a[i][j] = (i * (j + 2) + 2) / 250;
            b[i][j] = (i * (j + 3) + 3) / 250;
        }
    }

    for t in 0..100 {
        for i in 1..249 {
            for j in 1..249 {
                b[i][j] = (a[i][j] + a[i][j - 1] + a[i][j + 1] + a[i + 1][j] + a[i - 1][j]) / 5;
            }
        }
        for i in 1..249 {
            for j in 1..249 {
                a[i][j] = b[i][j];
            }
        }
    }

    let mut sum: int = 0;
    for i in 0..250 {
        for j in 0..250 {
            sum = sum + a[i][j];
        }
    }

    print_int(sum);
    print_char(10);
    sum
}
