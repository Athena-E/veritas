fn main() -> int {
    let mut a: [[int; 400]; 400] = [[0; 400]; 400];

    for i in 0..400 {
        for j in 0..400 {
            a[i][j] = (i * (j + 2) + 2) % 17;
        }
    }

    for t in 0..100 {
        for i in 1..399 {
            for j in 1..399 {
                a[i][j] =
                    (a[i - 1][j - 1] + a[i - 1][j] + a[i - 1][j + 1] +
                     a[i][j - 1] + a[i][j] + a[i][j + 1] +
                     a[i + 1][j - 1] + a[i + 1][j] + a[i + 1][j + 1]) / 9;
            }
        }
    }

    let mut sum: int = 0;
    for i in 0..400 {
        for j in 0..400 {
            sum = sum + a[i][j];
        }
    }

    print_int(sum);
    print_char(10);
    sum
}
