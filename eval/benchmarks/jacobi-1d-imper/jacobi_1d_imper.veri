fn main() -> int {
    let mut a: [int; 400] = [0; 400];
    let mut b: [int; 400] = [0; 400];

    for i in 0..400 {
        a[i] = (i + 2) / 400;
        b[i] = (i + 3) / 400;
    }

    for t in 0..100 {
        for i in 1..399 {
            b[i] = (a[i - 1] + a[i] + a[i + 1]) / 3;
        }
        for j in 1..399 {
            a[j] = b[j];
        }
    }

    let mut sum: int = 0;
    for i in 0..400 {
        sum = sum + a[i];
    }

    print_int(sum);
    print_char(10);
    sum
}
