// Floyd-Warshall benchmark in Veritas.
//
// PolyBench/C MEDIUM dataset: N = 500.
fn main() -> int {
    let mut path: [[int; 500]; 500] = [[0; 500]; 500];

    for i in 0..500 {
        for j in 0..500 {
            path[i][j] = (i + 1) * (j + 1) / 500;
        }
    }

    for k in 0..500 {
        for i in 0..500 {
            for j in 0..500 {
                let via: int = path[i][k] + path[k][j];
                if via < path[i][j] {
                    path[i][j] = via;
                } else {
                    let skip: int = 0;
                }
            }
        }
    }

    let mut sum: int = 0;
    for i in 0..500 {
        for j in 0..500 {
            sum = sum + path[i][j];
        }
    }

    print_int(sum);
    print_char(10);
    sum
}
