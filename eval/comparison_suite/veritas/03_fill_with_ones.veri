fn fill_with_ones() -> [int; 5]
    ensures forall j in 0..4 { result[j] == 1 }
{
    let mut arr: [int; 5] = [0; 5];
    for i in 0..5
        invariant forall j in 0..i { arr[j] == 1 }
    {
        arr[i] = 1;
    }
    arr
}

fn main() -> int {
    let arr: [int; 5] = fill_with_ones();
    arr[0] + arr[4]
}
