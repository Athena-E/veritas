fn sorted_head(arr: [int; 3]) -> int
    requires forall i in 0..2 { arr[i] <= arr[i + 1] }
{
    arr[0]
}

fn make_sorted() -> [int; 3]
    ensures forall i in 0..2 { result[i] <= result[i + 1] }
{
    let mut arr: [int; 3] = [0; 3];
    arr[0] = 1;
    arr[1] = 2;
    arr[2] = 3;
    arr
}

fn main() -> int {
    let arr: [int; 3] = make_sorted();
    sorted_head(arr)
}
