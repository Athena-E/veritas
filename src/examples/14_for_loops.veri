fn simple_loop() {
    for i in 0..10 {
        let x: int = i * 2;
    }
}

fn variable_range(start: int, end: int) {
    let mut sum: int = 0;
    for i in start..end {
        sum = sum + i;
    }
}

fn nested_loops() {
    for i in 0..3 {
        for j in 0..3 {
            let product: int = i * j;
        }
    }
}

fn complex_loop() {
    for i in 1..100 {
        let x: int = i * 2;
        let y: int = x + 5;
        let z: int = y * y;
    }
}

fn array_loop() {
    let mut arr: [int; 10] = [0; 10];
    for i in 0..10 {
        arr[i] = i * i;
    }
}
