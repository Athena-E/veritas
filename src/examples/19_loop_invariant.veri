
fn sum_loop() {
    let mut sum: int = 0;
    for i in 0..10 invariant i >= 0 {
        sum = sum + i;
    }
}

fn count_loop() {
    let mut count: int = 0;
    for i in 1..100 invariant i > 0 {
        count = count + 1;
    }
}

fn no_invariant_loop() {
    let mut x: int = 0;
    for i in 0..5 {
        x = x + 1;
    }
}

fn bounded_loop() {
    let mut total: int = 0;
    for i in 0..10 invariant i < 10 {
        total = total + i;
    }
}
