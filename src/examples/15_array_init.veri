fn simple_array_init() {
    let arr: [int; 10] = [0; 10];
}

fn array_init_with_value(val: int) {
    let arr: [int; 5] = [val; 5];
}

fn array_init_expression_value(x: int) {
    let arr: [int; 10] = [x * 2; 10];
}

fn initialize_and_modify() {
    let mut numbers: [int; 5] = [1; 5];
    numbers[0] = 10;
    numbers[1] = 20;
}

fn multiple_arrays() {
    let zeros: [int; 100] = [0; 100];
    let ones: [int; 50] = [1; 50];
    let flags: [bool; 10] = [true; 10];
}

fn array_in_loop() {
    for i in 0..10 {
        let temp: [int; 10] = [i; 10];
    }
}
